//- Карточка роботи портфоліо (eager - перша карточка на першому екрані, без lazy); ховер-оверлей працює і з клавіатури (:focus-within)
mixin work-card(work, eager = false)
  - const categoryLabel = (filters.find((f) => f.id === work.category) || {}).label || work.category;
  article.work-card
    a.work-card__link(href='#')
      +picture({
        name: work.image || 'image',
        alt: work.alt,
        width: 800,
        height: 800,
        widths: [400, 800],
        sizes: workSizes,
        cls: 'work-card__img',
        eager,
      })
      .work-card__overlay
        span.work-card__plus
          +icon('plus')
        h3.work-card__title= work.title
        span.work-card__line
        span.work-card__category= categoryLabel
